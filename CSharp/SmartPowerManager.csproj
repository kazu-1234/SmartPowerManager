<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>SmartPowerManager</RootNamespace>
    <AssemblyName>SmartPowerManager</AssemblyName>
    <ApplicationIcon>Assets\app_icon.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x86;x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>
    <Platform Condition="'$(Platform)' == '' Or '$(Platform)' == 'AnyCPU'">x64</Platform>
    <UseWinUI>true</UseWinUI>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <WindowsPackageType>None</WindowsPackageType>
    <ApplicationDefaultLanguage>ja-JP</ApplicationDefaultLanguage>
    <Version>2.4.0</Version>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <!-- 配布（単一 exe・dotnet publish 時）に必要な WinUI unpackaged 設定 -->
    <SelfContained Condition="'$(PublishSingleFile)' == 'true'">true</SelfContained>
    <EnableMsixTooling>true</EnableMsixTooling>
    <IncludeAllContentForSelfExtract Condition="'$(PublishSingleFile)' == 'true'">true</IncludeAllContentForSelfExtract>
    <IncludeNativeLibrariesForSelfExtract Condition="'$(PublishSingleFile)' == 'true'">true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile Condition="'$(PublishSingleFile)' == 'true'">true</EnableCompressionInSingleFile>
    <DefineConstants>DISABLE_XAML_GENERATED_MAIN;DISABLE_XAML_GENERATED_BREAK_ON_UNHANDLED_EXCEPTION</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="Assets\app_icon.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
  <!-- Debug ビルド前に常駐プロセスを終了し、exe ロックによるビルド失敗を防ぐ -->
  <Target Name="StopRunningInstanceBeforeBuild" BeforeTargets="PrepareForBuild" Condition="'$(Configuration)' == 'Debug'">
    <Exec Command="taskkill /F /IM $(AssemblyName).exe /T 2&gt;nul" IgnoreExitCode="true" />
  </Target>
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.WinUI.Controls.SettingsControls" Version="8.2.250402" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.0.1" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="TaskScheduler" Version="2.12.2" />
  </ItemGroup>
  <ItemGroup>
    <!-- 共通基盤 WinUiShared は Template（..\WinUiAppTemplate\Shared）が正本。リポ単体でビルドできるようにコピーを Shared\ に同梱する。
         直すときは Template 側を直し、scripts\sync-shared.ps1 で同期する（Shared\ を直接書き換えない） -->
    <ProjectReference Include="..\Shared\WinUiShared.csproj" />
  </ItemGroup>
  <!--
    dotnet publish（未パッケージ・自己完結）では、アプリ本体の <AssemblyName>.pri が publish フォルダへコピーされないことがある
    （WinUiShared.pri などは入る）。.pri には XAML と .resw の文言が入っており、無いとインストール版だけが起動直後に
    何も出さず終了する（Debug 実行は正常・ログにも例外が出ない）。publish の後にビルド出力から明示的にコピーする。
  -->
  <Target Name="CopyAppPriToPublishDir" AfterTargets="Publish">
    <Copy SourceFiles="$(OutDir)$(TargetName).pri"
          DestinationFolder="$(PublishDir)"
          Condition="Exists('$(OutDir)$(TargetName).pri')" />
  </Target>
</Project>
