<Page
    x:Class="SmartPowerManager.Views.ShutdownPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:SmartPowerManager.Views"
    HorizontalAlignment="Stretch"
    VerticalAlignment="Stretch">
    <views:PageScrollHost>
        <Grid x:Name="PageRoot" Style="{StaticResource PageBaseContentGridStyle}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock x:Name="PageTitleText"
                       Grid.Row="0"
                       Text="シャットダウン"
                       Style="{StaticResource PageTitleTextStyle}" />

            <Grid x:Name="ScheduleSplitGrid"
                  Grid.Row="1"
                  ColumnSpacing="12"
                  RowSpacing="12"
                  VerticalAlignment="Top">
                <VisualStateManager.VisualStateGroups>
                    <VisualStateGroup x:Name="SplitStates">
                        <VisualState x:Name="Wide">
                            <VisualState.StateTriggers>
                                <AdaptiveTrigger MinWindowWidth="1100" />
                            </VisualState.StateTriggers>
                            <VisualState.Setters>
                                <Setter Target="LeftColumn.(Grid.Row)" Value="0" />
                                <Setter Target="LeftColumn.(Grid.Column)" Value="0" />
                                <Setter Target="LeftColumn.(Grid.ColumnSpan)" Value="1" />
                                <Setter Target="RightColumn.(Grid.Row)" Value="0" />
                                <Setter Target="RightColumn.(Grid.Column)" Value="1" />
                                <Setter Target="RightColumn.(Grid.ColumnSpan)" Value="1" />
                                <Setter Target="BottomRow.Height" Value="0" />
                            </VisualState.Setters>
                        </VisualState>
                        <VisualState x:Name="Narrow">
                            <VisualState.Setters>
                                <Setter Target="LeftColumn.(Grid.Row)" Value="0" />
                                <Setter Target="LeftColumn.(Grid.Column)" Value="0" />
                                <Setter Target="LeftColumn.(Grid.ColumnSpan)" Value="2" />
                                <Setter Target="RightColumn.(Grid.Row)" Value="1" />
                                <Setter Target="RightColumn.(Grid.Column)" Value="0" />
                                <Setter Target="RightColumn.(Grid.ColumnSpan)" Value="2" />
                                <Setter Target="BottomRow.Height" Value="Auto" />
                            </VisualState.Setters>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateManager.VisualStateGroups>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.4*" MinWidth="0" />
                    <ColumnDefinition Width="*" MinWidth="0" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition x:Name="BottomRow" Height="0" />
                </Grid.RowDefinitions>

                <StackPanel x:Name="LeftColumn" Spacing="0">
                    <TextBlock Text="スケジュール設定" Style="{StaticResource SettingsSectionHeaderFirstStyle}" />
                    <Border x:Name="LeftCard" Style="{StaticResource ScheduleCardBorderStyle}">
                        <ContentControl FontSize="15"
                                        HorizontalContentAlignment="Stretch"
                                        VerticalContentAlignment="Stretch"
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Stretch">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" MinHeight="88" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid Style="{StaticResource ScheduleFormRowStyle}"
                                          ColumnSpacing="10"
                                          VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" MinWidth="0" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="2" VerticalAlignment="Center">
                                            <TextBlock Text="スケジュール監視" Style="{StaticResource CardFormTitleStyle}" />
                                            <TextBlock x:Name="MonitorStatusText"
                                                       Style="{StaticResource CardDescriptionTextStyle}"
                                                       Text="監視中" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Style="{StaticResource FormRowStackPanelStyle}">
                                            <ToggleSwitch x:Name="MonitorToggle"
                                                          Style="{StaticResource ScheduleToggleSwitchStyle}"
                                                          ToolTipService.ToolTip="スケジュール監視の有効／無効"
                                                          Toggled="MonitorToggle_Toggled" />
                                        </StackPanel>
                                    </Grid>
                                    <Border Grid.Row="1" Style="{StaticResource ScheduleRowDividerStyle}" />
                                </Grid>

                                <Grid Grid.Row="1">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid Style="{StaticResource ScheduleFormRowStyle}"
                                          ColumnSpacing="10"
                                          VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" MinWidth="0" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="クイック設定：x時間後"
                                                   Style="{StaticResource CardFormTitleStyle}"
                                                   VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1" Style="{StaticResource FormRowStackPanelStyle}">
                                            <Button Content="1h" Style="{StaticResource QuickActionButtonStyle}" Click="QuickButton_Click" Tag="1" />
                                            <Button Content="3h" Style="{StaticResource QuickActionButtonStyle}" Click="QuickButton_Click" Tag="3" />
                                            <Button Content="6h" Style="{StaticResource QuickActionButtonStyle}" Click="QuickButton_Click" Tag="6" />
                                            <Button Content="9h" Style="{StaticResource QuickActionButtonStyle}" Click="QuickButton_Click" Tag="9" />
                                            <Button Content="12h" Style="{StaticResource QuickActionButtonStyle}" Click="QuickButton_Click" Tag="12" />
                                        </StackPanel>
                                    </Grid>
                                    <Border Grid.Row="1" Style="{StaticResource ScheduleRowDividerStyle}" />
                                </Grid>

                                <Grid Grid.Row="2">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid Style="{StaticResource ScheduleFormRowStyle}"
                                          ColumnSpacing="10"
                                          VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" MinWidth="0" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="毎日スケジュール"
                                                   Style="{StaticResource CardFormTitleStyle}"
                                                   VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1" Style="{StaticResource FormRowStackPanelStyle}">
                                            <views:CompactTimeInput x:Name="DailyTimeInput" TimeChanged="DailyTimeInput_TimeChanged" />
                                            <ToggleSwitch x:Name="DailyToggle"
                                                          Style="{StaticResource ScheduleToggleSwitchStyle}"
                                                          ToolTipService.ToolTip="毎日スケジュールの有効／無効"
                                                          Toggled="DailyToggle_Toggled" />
                                        </StackPanel>
                                    </Grid>
                                    <Border Grid.Row="1" Style="{StaticResource ScheduleRowDividerStyle}" />
                                </Grid>

                                <Grid Grid.Row="3">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid Style="{StaticResource ScheduleFormRowStyle}"
                                          ColumnSpacing="10"
                                          VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" MinWidth="0" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="毎週スケジュールを追加"
                                                   Style="{StaticResource CardFormTitleStyle}"
                                                   VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1" Style="{StaticResource FormRowStackPanelStyle}">
                                            <ComboBox x:Name="WeeklyWeekdayBox"
                                                  Style="{StaticResource CompactComboBoxWeekdayStyle}"
                                                  Width="74"
                                                  MinWidth="74"
                                                  MaxWidth="74" />
                                            <views:CompactTimeInput x:Name="WeeklyTimeInput" />
                                            <Button Content="追加" Style="{StaticResource PrimaryActionButtonStyle}" Click="AddWeeklyButton_Click" />
                                        </StackPanel>
                                    </Grid>
                                    <Border Grid.Row="1" Style="{StaticResource ScheduleRowDividerStyle}" />
                                </Grid>

                                <Grid Grid.Row="4">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid Style="{StaticResource ScheduleFormRowStyle}"
                                          ColumnSpacing="10"
                                          VerticalAlignment="Center"
                                          Padding="0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" MinWidth="0" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="一回限り"
                                                   Style="{StaticResource CardFormTitleStyle}"
                                                   VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1"
                                                    Style="{StaticResource FormRowStackPanelStyle}"
                                                    VerticalAlignment="Center">
                                            <views:CompactDateTimeInput x:Name="OnetimeDateTimeInput" />
                                            <Button Content="追加"
                                                    Style="{StaticResource PrimaryActionButtonStyle}"
                                                    VerticalAlignment="Center"
                                                    Click="AddOnetimeButton_Click" />
                                        </StackPanel>
                                    </Grid>
                                    <Border Grid.Row="1" Style="{StaticResource ScheduleRowDividerStyle}" />
                                </Grid>

                                <Grid Grid.Row="5" Style="{StaticResource ScheduleFormRowStyle}"
                                      ColumnSpacing="10"
                                      VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" MinWidth="0" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="次回シャットダウン予定" Style="{StaticResource CardFormTitleStyle}" />
                                        <TextBlock x:Name="NextScheduleText" Style="{StaticResource CardDescriptionTextStyle}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Style="{StaticResource FormRowStackPanelStyle}">
                                        <Button Content="次回予定をキャンセル"
                                                Style="{StaticResource SecondaryActionButtonStyle}"
                                                Click="CancelNextButton_Click" />
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </ContentControl>
                    </Border>
                </StackPanel>

                <StackPanel x:Name="RightColumn" Grid.Column="1" Spacing="0">
                    <TextBlock Text="スケジュール一覧" Style="{StaticResource SettingsSectionHeaderFirstStyle}" />
                    <views:UpcomingSchedulePanel x:Name="RightCard" FontSize="15" />
                </StackPanel>
            </Grid>
        </Grid>
    </views:PageScrollHost>
</Page>
