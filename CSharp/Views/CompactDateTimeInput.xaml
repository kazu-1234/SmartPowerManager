<UserControl
    x:Class="SmartPowerManager.Views.CompactDateTimeInput"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:SmartPowerManager.Views"
    MinHeight="76"
    VerticalAlignment="Center"
    HorizontalAlignment="Right">
    <Grid ColumnSpacing="4" RowSpacing="6" HorizontalAlignment="Right">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="78" />
            <ColumnDefinition Width="62" />
            <ColumnDefinition Width="62" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ComboBox x:Name="YearBox"
                  Grid.Row="0"
                  Grid.Column="0"
                  Style="{StaticResource CompactComboBoxYearStyle}"
                  Width="78"
                  MinWidth="78"
                  MaxWidth="78"
                  SelectionChanged="YearOrMonth_Changed" />
        <ComboBox x:Name="MonthBox"
                  Grid.Row="0"
                  Grid.Column="1"
                  Style="{StaticResource CompactComboBoxMonthDayStyle}"
                  Width="62"
                  MinWidth="62"
                  MaxWidth="62"
                  SelectionChanged="YearOrMonth_Changed" />
        <ComboBox x:Name="DayBox"
                  Grid.Row="0"
                  Grid.Column="2"
                  Style="{StaticResource CompactComboBoxMonthDayStyle}"
                  Width="62"
                  MinWidth="62"
                  MaxWidth="62"
                  SelectionChanged="DayBox_SelectionChanged" />

        <views:CompactTimeInput x:Name="TimeInput"
                                Grid.Row="1"
                                Grid.Column="1"
                                Grid.ColumnSpan="2"
                                HorizontalAlignment="Stretch"
                                TimeChanged="TimeInput_TimeChanged" />
    </Grid>
</UserControl>
